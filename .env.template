# ==============================================================================
# RWQAN - Environment Variables Template
# ==============================================================================
# Copy this file to .env and replace every placeholder. Never commit .env.

# Development kill-switch: the server refuses to start in a non-production
# environment while any external service credential is present unless this is
# explicitly set to "true". Keep it unset or "false" for isolated local runs.
ALLOW_EXTERNAL_SERVICES_IN_DEVELOPMENT=false

# General and privileged access
PORT=5000
NODE_ENV=development
SESSION_SECRET=replace_with_a_long_random_secret
# Stable HMAC key for owner phone indexes and auth throttles. Do not rotate it
# with SESSION_SECRET; use a separate random value of at least 32 bytes.
OWNER_ACCOUNT_HMAC_SECRET=replace_with_a_separate_32_byte_random_secret
ADMIN_CODE=replace_with_a_private_admin_code
ADMIN_PASSWORD=replace_with_a_strong_unique_password
# DEV-ONLY local testing aid. When set to "console" in an isolated development
# run (NODE_ENV=development, the rwqan-sa-dev project, external services
# disabled), the real customer OTP is printed to the server console instead of
# being sent over WhatsApp. Leave empty in production; it is ignored outside the
# isolated development target.
DEV_CUSTOMER_OTP_SINK=
NEXT_PUBLIC_BASE_URL=https://your-production-domain.example
PUBLIC_BASE_URL=https://your-production-domain.example

# Booking follow-up and commission worker
BOOKING_WORKER_SECRET=replace_with_a_separate_32_byte_random_secret
# Local safety switch. Leave false when development uses production Firebase.
ENABLE_SCHEDULERS_IN_DEVELOPMENT=false
# Legacy booking-worker-only development opt-in (also defaults to disabled).
ENABLE_BOOKING_WORKER_IN_DEVELOPMENT=false
CUSTOMER_BOOKING_FOLLOWUP_DAILY_LIMIT=3
CUSTOMER_BOOKING_FOLLOWUP_DELAY_MINUTES=1440
FREE_OWNER_BOOKING_NOTIFICATION_DAILY_LIMIT=3
FREE_PROPERTY_DAILY_CONTACT_LIMIT=3

# Firebase Firestore
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project-id"}'
# Required for local development: the DEV project_id the service account must match.
FIREBASE_DEV_PROJECT_ID=your_firebase_dev_project_id

# RWQAN LIVE DATA — DEV-only, READ-ONLY preview of real production data.
# Disabled (fail closed) unless ALL of the following are set correctly. This is a
# dedicated READ-ONLY connection: never reuse the broad production
# FIREBASE_SERVICE_ACCOUNT here, and never point it at the DEV project.
# LIVE_DATA_READONLY_ACK=read-only
# LIVE_FIREBASE_PROJECT_ID=your_production_project_id
# LIVE_FIREBASE_READONLY_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your_production_project_id"}'
# LIVE_R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# LIVE_R2_ACCESS_KEY_ID=your_read_only_key_id
# LIVE_R2_SECRET_ACCESS_KEY=your_read_only_secret_key
# LIVE_R2_BUCKET_NAME=your_production_bucket_name
# LIVE_R2_PUBLIC_URL=https://your-production-public-r2-domain.example
# LIVE_R2_REGION=auto

# Legacy Google Sheets migration/fallback
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Paymob KSA
PAYMOB_API_KEY=your_paymob_api_key
PAYMOB_SECRET_KEY=your_paymob_secret_key
PAYMOB_PUBLIC_KEY=your_paymob_public_key
PAYMOB_HMAC_SECRET=your_paymob_hmac_secret
PAYMOB_LEGACY_API_KEY=your_legacy_api_key_if_used
PAYMOB_INTEGRATION_ID_CARDS=your_cards_integration_id
PAYMOB_INTEGRATION_ID_APPLEPAY=your_apple_pay_integration_id

# WhatsApp / Meta Cloud API
META_WHATSAPP_TOKEN=your_meta_access_token
META_PHONE_NUMBER_ID=your_meta_phone_number_id
META_NOTIFY_NUMBER=9665XXXXXXXX
# From Meta App Dashboard > App settings; used only to verify webhook signatures.
META_WHATSAPP_APP_SECRET=replace_with_your_meta_app_secret
# Configure this same high-entropy token when subscribing the Meta webhook URL.
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace_with_a_separate_32_byte_random_token
WHATSAPP_PHONE_NUMBER_ID=your_legacy_phone_number_id_if_used
WHATSAPP_ACCESS_TOKEN=your_legacy_access_token_if_used
ADMIN_WHATSAPP=9665XXXXXXXX

# Enjazatik notifications
ENJAZATIK_URL=https://your-provider.example/api/send-message
ENJAZATIK_TOKEN=your_enjazatik_token
# Configure this same high-entropy value on an Enjazatik/custom relay callback.
WHATSAPP_DELIVERY_WEBHOOK_SECRET=replace_with_a_separate_32_byte_random_secret

# Cloudflare R2 / S3-compatible storage
R2_REGION=auto
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://your-public-r2-domain.example

# CAPTCHA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# AI integrations (only configure providers that are used)
AI_INTEGRATIONS_OPENAI_API_KEY=your_openai_api_key
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
