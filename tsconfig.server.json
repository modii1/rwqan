{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "commonjs",
        "outDir": "dist",
        "target": "es2020",
        "downlevelIteration": true,
        "moduleResolution": "node",
        "noEmit": false
    },
    "include": [
        "server/**/*",
        "shared/**/*"
    ],
    "exclude": [
        "server/replit_integrations"
    ]
}